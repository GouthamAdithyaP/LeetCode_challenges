import java.util.HashMap;

public class RomanToInteger {
    public static void main(String args[]) {
        String Roman = "I";
        HashMap<Character,Integer> map =new HashMap<>();
        map.put('I',1);
        map.put('V',5);
        map.put('X',10);
        map.put('L',50);
        map.put('C',100);
        map.put('D',500);
        map.put('M',1000);
        int finalVal=0;
        for (int i = 0; i < Roman.length(); i++) {
            char first = Roman.charAt(i);
            if(i==Roman.length()-1){
                finalVal+= map.get(first);
                System.out.print("The integer value is "+finalVal);
                break;
            }
            char second = Roman.charAt(i + 1);
            if(map.get(first)>map.get(second) || map.get(first)== map.get(second) ){
                finalVal+= map.get(first);
            }
            else
            {
                finalVal-= map.get(first);
            }
        }
    }
}
